{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension",
      "type": "shell",
      "command": "bun",
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Watch Extension",
      "type": "shell",
      "command": "bun",
      "args": ["run", "watch:extension"],
      "isBackground": true,
      "problemMatcher": [
        "$tsc-watch"
      ]
    },
    {
      "label": "Build Webview",
      "type": "shell",
      "command": "bun",
      "args": ["run", "build:webview"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
